{
	"name": "n8n-nodes-fixed-sender-email",
	"version": "0.1.0",
	"description": "n8n node for sending emails with a fixed sender address from SMTP credentials",
	"license": "MIT",
	"homepage": "https://github.com/uppinote20/n8n-nodes-fixed-sender-email",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"email",
		"smtp",
		"nodemailer",
		"fixed-sender"
	],
	"author": {
		"name": "uppinote",
		"email": "upnote2020@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/uppinote20/n8n-nodes-fixed-sender-email.git"
	},
	"bugs": {
		"url": "https://github.com/uppinote20/n8n-nodes-fixed-sender-email/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": false,
		"credentials": [
			"dist/credentials/FixedSenderSmtpApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/FixedSenderEmail/FixedSenderEmail.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"@types/nodemailer": "^7.0.4",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"nodemailer": "^7.0.10"
	}
}
